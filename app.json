{
  "expo": {
    "name": "Athlete Tracker",
    "slug": "tournament-tracker",
    "scheme": "athletetracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.athletetracker.mobile"
    },
    "android": {
      "package": "com.athletetracker.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EE"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Athlete Tracker to use Face ID to protect your private financial information."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "5ef43fa1-f7d4-4b00-b859-b8a6db788ccc"
      },
      "router": {}
    },
    "owner": "sillycabana"
  }
}
